# PostgreSQL connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=obsuser
DB_PASSWORD=pass1234
DB_NAME=obs_saas_dev
DB_SSLMODE=disable
# Auth
JWT_SECRET=super-secret-change-me-in-prod-32-chars-min
REFRESH_TOKEN_PEPPER=dev-refresh-token-pepper-32-chars-minimum!
JWT_ISSUER=obs-platform
JWT_AUDIENCE=obs-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Cookies (dev)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# CORS (CSV)
CORS_ALLOW_ORIGINS=http://localhost:5173
# Port for the Go backend server
SERVER_PORT=8080
# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
# Infra connection details (for internal use by the Go backend to connect to the observability stack)
VMINSERT_HOST=vminsert
VMINSERT_PORT=8480
VMSELECT_HOST=vmselect
VMSELECT_PORT=8481
LOKI_HOST=loki
LOKI_PORT=3100
TEMPO_HOST=tempo
TEMPO_PORT=4318
GRAFANA_URL=http://grafana:3000
AGENT_INSTALL_SCRIPT_PATH=/opt/agent/install.sh

# NVD API key for vulnerability scanning (get one at https://nvd.nist.gov/developers/request-an-api-key)
# Without this, NVD rate limits will block the scanner
NVD_API_KEY=

# ── SMTP / Email ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Observability Medianet
PLATFORM_URL=http://localhost:5173

# ── AI reports ───────────────────────────────────────────────────
# Required to enable AI reports. Leave empty to disable generation
# (existing reports still list/view fine; generation fails with a clear error).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# AI_PROVIDER: "gemini" (default) or "groq". The other provider is used as a
# fallback when its key is also set.
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Payloads larger than this are split per UTC region to fit provider token limits.
AI_CHUNK_BYTES=35000
