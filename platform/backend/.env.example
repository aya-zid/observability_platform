# PostgreSQL connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=obsuser
DB_PASSWORD=pass1234
DB_NAME=obs_saas_dev
DB_SSLMODE=disable
# Auth
JWT_SECRET=super-secret-change-me-in-prod-32-chars-min
REFRESH_TOKEN_PEPPER=dev-refresh-token-pepper-32-chars-minimum!!
JWT_ISSUER=obs-platform
JWT_AUDIENCE=obs-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Cookies (dev)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# CORS (CSV)
CORS_ALLOW_ORIGINS=http://localhost:5173
# Port for the Go backend server
SERVER_PORT=8080
# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
# Infra connection details (for internal use by the Go backend to connect to the observability stack)
VMINSERT_HOST=vminsert
VMINSERT_PORT=8480
VMSELECT_HOST=vmselect
VMSELECT_PORT=8481
LOKI_HOST=loki
LOKI_PORT=3100
TEMPO_HOST=tempo
TEMPO_PORT=4318
GRAFANA_URL=http://grafana:3000
AGENT_INSTALL_SCRIPT_PATH=/opt/agent/install.sh
